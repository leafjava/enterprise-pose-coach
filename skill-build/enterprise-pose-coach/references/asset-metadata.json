{
  "$schema": "https://clawhive.example.invalid/schemas/skill-asset-metadata/v1.json",
  "skill": {
    "name": "enterprise-pose-coach",
    "display_name": "练了么 · AI 体能数字员工",
    "version": "1.0.0",
    "vendor": "lian-le-ma",
    "category": "computer-vision",
    "track": "ai-development",
    "architecture": "train_then_reuse",
    "architecture_note": "本 Skill 自带 训练 + 沉淀 + 复用 生命周期：首次调用训练垂直模型并选 Best 权重沉淀；后续每一次调用都直接加载 Best 权重。Best 权重可下载、可私有部署、可重复调用、可持续进化（旧版可回滚）。",
    "key_message": "传统 Skill 编排已有能力；练了么 Skill 帮助 Agent 训练、沉淀并持续调用新的垂直能力。",
    "min_runtime": {
      "python": "3.10",
      "memory_mb": 1024,
      "gpu": "optional",
      "cuda": "optional"
    }
  },
  "assets": {
    "models": [
      {
        "id": "rtmpose-onnx",
        "role": "general-base",
        "kind": "pose-estimation",
        "format": "onnx",
        "size_mb": 40,
        "license": "internal",
        "path_hint": "model/rtmo-*.onnx",
        "inputs": ["image"],
        "outputs": ["keypoints:17x2_or_17x3"],
        "provider": "onnxruntime"
      },
      {
        "id": "stgcn-mmfit-11cls-stride48",
        "role": "general-base",
        "kind": "action-classification",
        "format": "pytorch",
        "size_mb": 1,
        "license": "internal",
        "path_hint": "model/mmfit_pose11cls_stride48_best.pth",
        "base_version": "stgcn-mmfit-11cls-stride48@2026-05-29",
        "note": "成熟通用模型；训练 Best 权重的起点",
        "inputs": ["keypoint_sequence:48x17x2"],
        "outputs": ["class:11", "confidence:1"],
        "provider": "pytorch"
      },
      {
        "id": "best-weight-placeholder",
        "role": "best-weight",
        "kind": "action-classification-tenant-finetune",
        "format": "pytorch",
        "size_mb": 1,
        "license": "tenant-private",
        "path_hint": "model/bw_<tenant>_<date>_<version>.pth",
        "produced_by": "this-skill-first-call",
        "trained_from": "stgcn-mmfit-11cls-stride48",
        "note": "本 Skill 首次调用训练后沉淀；后续调用直接加载；旧版本保留可回滚",
        "inputs": ["keypoint_sequence:48x17x2"],
        "outputs": ["class:11", "confidence:1"],
        "provider": "pytorch"
      },
      {
        "id": "yolov8n",
        "role": "support",
        "kind": "person-detection",
        "format": "pytorch",
        "size_mb": 7,
        "license": "agpl-3.0",
        "path_hint": "yolov8n.pt",
        "inputs": ["image"],
        "outputs": ["bboxes", "scores"],
        "provider": "pytorch"
      }
    ],
    "rules": [
      {
        "id": "RECRUIT_SQUAT_50_V1",
        "kind": "exercise-rule-set",
        "version": "1",
        "exercise": "squats",
        "scope": "recruitment-screening",
        "criteria": {
          "target_reps": 50,
          "depth": "hip_below_knee",
          "knee_alignment": "knee_over_toe",
          "torso_tilt_max_deg": 45
        }
      }
    ],
    "data_sources": [
      {
        "id": "demo-seed",
        "kind": "fixture",
        "path_hint": "data/demo/enterprise_demo.json",
        "license": "internal",
        "synthetic": true
      },
      {
        "id": "mmfit-21subjects",
        "role": "general-base-training-corpus",
        "kind": "training-corpus",
        "subjects": 21,
        "windows": 8898,
        "shape": [8898, 2, 48, 17],
        "license": "research-only"
      },
      {
        "id": "tenant-desensitized-samples",
        "role": "best-weight-training-corpus",
        "kind": "tenant-uploaded",
        "license": "tenant-private",
        "note": "企业脱敏样本；只在 Skill 首次调用训练链路中使用，不进入公共数据集"
      }
    ],
    "prompts": [
      {
        "id": "coach-feedback-system",
        "path": "prompts/coach-feedback-system.txt",
        "model": "ollama:gemma4:e2b",
        "optional": true,
        "fallback": "rule-engine-cue"
      }
    ],
    "examples": [
      "examples/input-request.json",
      "examples/output-pass.json",
      "examples/output-not-met.json",
      "examples/output-inconclusive.json",
      "examples/base-train-request.json",
      "examples/base-train-response.json"
    ]
  },
  "api": {
    "consumed": [],
    "produced": [
      {
        "id": "task.create",
        "kind": "skill-input",
        "description": "ClawHive Agent → Skill: create a recruit/onboarding/training task; 首次调用 best_weight_id 不填",
        "schema": "examples/input-request.json"
      },
      {
        "id": "task.callback",
        "kind": "skill-output",
        "description": "Skill → ClawHive Agent: structured result + best_weight_id + best_weight_version",
        "schema": "examples/output-pass.json"
      },
      {
        "id": "skill.init",
        "kind": "skill-first-call",
        "description": "首次调用：训练垂直模型，按 训练 + 沉淀 流程产出 best_weight_id",
        "schema": "examples/base-train-request.json"
      },
      {
        "id": "skill.init.done",
        "kind": "skill-first-call-output",
        "description": "首次调用完成：返回 best_weight_id + 训练指标 + 权重哈希",
        "schema": "examples/base-train-response.json"
      }
    ],
    "external_dependencies": [
      {
        "name": "ollama",
        "kind": "local-runtime",
        "required": false,
        "purpose": "生成式教练文案；规则链路不依赖",
        "default_model": "gemma4:e2b"
      }
    ]
  },
  "permissions": {
    "camera": "required",
    "microphone": "denied",
    "network": "webhook-out-only",
    "raw_frame_persistence": "denied",
    "raw_frame_upload_to_llm": "denied",
    "best_weight_artifact_download": "tenant-scoped",
    "best_weight_retrain_trigger": "tenant-scoped"
  },
  "limits": {
    "max_session_seconds": 1800,
    "max_target_reps": 200,
    "min_target_reps": 1,
    "concurrent_sessions_per_tenant": 4,
    "rate_limit_per_minute": 30
  },
  "compliance": {
    "data_classification": "biometric-employment-screening",
    "retention_default_days": 365,
    "human_review_required_for": ["decision: inconclusive", "decision: not_met"],
    "prohibited_uses": [
      "medical-diagnosis",
      "rehabilitation-prescription",
      "injury-prediction",
      "performance-evaluation",
      "compensation-decision"
    ]
  }
}